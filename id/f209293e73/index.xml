&lt;/li&gt;
&lt;li&gt;
&lt;a href="https://roman-gardens.github.io/test-drafts/search/?q=dolia"&gt;dolia&lt;/a&gt; (&lt;a class="id" target="_blank" href="http://vocab.getty.edu/page/aat/300400601" title="Art and Architecture Thesaurus (Getty)"&gt;AAT:300400601&lt;/a&gt;)
&lt;/li&gt;
&lt;/ul&gt;
